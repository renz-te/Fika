RewriteEngine On

# Force remove .php from the visible URL (External Redirect)
RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{REQUEST_URI} !^/Fika/cafe_hrms/api/
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^(.+)\.php$ $1 [R=301,L]

# Internally map the clean URL back to the .php file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]
